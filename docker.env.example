# Copy to .env (same folder as docker-compose.yml). Paths are relative to this file unless absolute.

# Repo root for bind mounts (default: . = folder containing docker-compose.yml)
# Windows absolute example:
# MINATALKER_PROJECT_DIR=C:/Project/MinaTalker
MINATALKER_PROJECT_DIR=.

# MINATALKER_CONFIG=config/config_wav2lip.yaml
# Required for Agora Secured mode (RTC token generation on /agora/join):
# AGORA_APP_CERTIFICATE=your_primary_certificate_from_agora_console
# SSL_CN=localhost
