# Copy to `.env.development` or `.env.production` and adjust paths to match your Swagger/OpenAPI
# Docs: http://minamina-alb-core-650854261.ap-southeast-1.elb.amazonaws.com/docs

# Dev (Vite): same-origin proxy avoids CORS — see vite.config.js `/internal-core`
VITE_INTERNAL_API_BASE=/internal-core

# Production build: full origin (must match CORS on the core API)
# VITE_INTERNAL_API_BASE=http://minamina-alb-core-650854261.ap-southeast-1.elb.amazonaws.com

# Login / refresh paths (must match your API spec)
VITE_AUTH_LOGIN_PATH=/api/auth/login
VITE_AUTH_REFRESH_PATH=/api/auth/refresh

# JSON field names for login body
VITE_AUTH_USER_FIELD=username
# VITE_AUTH_USER_FIELD=email

VITE_AUTH_PASS_FIELD=password

# Set true to show "Continue without account" on the login screen
# VITE_INTERNAL_AUTH_OPTIONAL=true
#
# If you never see a Network request to the ELB: the login screen is skipped when either
#   - sessionStorage internal_auth_skip=1 (after "Continue without account"), or
#   - sessionStorage/localStorage internal_access_token is already set.
# Clear those (Application → Storage) to test login again.
#
# Production: VITE_* values are baked in at `npm run build`. Redeploy dist after changing .env.
#
# VITE_DEBUG_INTERNAL_AUTH=true

# Optional: also persist tokens in localStorage (survives tab close)
# VITE_AUTH_PERSIST=local

# If your refresh endpoint only needs Authorization: Bearer <access_token> (no refresh_token)
# VITE_AUTH_REFRESH_USE_BEARER=true

# Login/refresh HTTP timeout (ms). Prevents “Signing in…” forever on hung ELB/CORS/TLS.
# VITE_AUTH_REQUEST_TIMEOUT_MS=30000
